<Window x:Class="AionMeter.App.Windows.CubeAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hidden cube" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        IsHitTestVisible="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">
    <!-- "A hidden cube is near": a card of its own in the middle of the screen, like the game's own toasts; it never
         takes the mouse or the keyboard -->
    <Border Margin="14" CornerRadius="12" BorderThickness="1" Padding="14,10,18,10" MinWidth="330">
        <Border.Background>
            <SolidColorBrush Color="#14101A" Opacity="0.9" />
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#99E77C93" Offset="0" />
                <GradientStop Color="#33E77C93" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.65" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- A little cube in a glowing tile -->
            <Border Width="42" Height="42" CornerRadius="8" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#80E77C93">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#55E77C93" Offset="0" />
                        <GradientStop Color="#1AE77C93" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Viewbox Margin="7">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,2 L21,7 L12,12 L3,7 Z" Fill="#FFE9EE" />
                        <Path Data="M3,7 L12,12 L12,22 L3,17 Z" Fill="#E79AAA" />
                        <Path Data="M21,7 L12,12 L12,22 L21,17 Z" Fill="#B9566C" />
                        <Path Data="M12,8.2 L15,10 L12,11.8 L9,10 Z" Fill="#D2455F" />
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="11" FontWeight="Bold" Foreground="#F07A8F" />
                <TextBlock x:Name="MessageText" FontSize="15.5" FontWeight="Bold" Foreground="White" Margin="0,1,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
                <!-- From the chime: which side, nearer or farther -->
                <TextBlock x:Name="HintText" FontSize="12" Foreground="#E8B6C1" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Which way the cube's hum comes from: an arrow lying on the ground, turned up to 90° to the louder
                     side (straight up = ahead, or behind: stereo cannot tell) -->
                <Grid x:Name="Arrow" Width="84" Height="64" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                    </Grid.LayoutTransform>
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.7" Color="Black" />
                    </Grid.Effect>
                    <!-- Its thickness: the same arrow a little lower, dark -->
                    <Canvas Width="60" Height="60" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="ArrowTurnBack" />
                                <ScaleTransform ScaleY="0.62" />
                                <TranslateTransform Y="5" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <Path Data="M30,2 L56,30 L41,30 L41,58 L19,58 L19,30 L4,30 Z" Fill="#7A2236" />
                    </Canvas>
                    <Canvas Width="60" Height="60" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="ArrowTurn" />
                                <ScaleTransform ScaleY="0.62" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                        <!-- Lit half and shaded half, split down the middle like a ridge -->
                        <Path Data="M30,2 L4,30 L19,30 L19,58 L30,58 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFF0F3" Offset="0" />
                                    <GradientStop Color="#F29AAD" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path Data="M30,2 L56,30 L41,30 L41,58 L30,58 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E77C93" Offset="0" />
                                    <GradientStop Color="#B23A55" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Canvas>
                </Grid>
                <!-- Warmer / colder: the hum's loudness, the more bars the nearer the cube -->
                <StackPanel x:Name="Meter" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,14,4">
                    <Rectangle x:Name="Bar1" Width="5" Height="6" RadiusX="1" RadiusY="1" Margin="0,0,3,0" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="Bar2" Width="5" Height="10" RadiusX="1" RadiusY="1" Margin="0,0,3,0" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="Bar3" Width="5" Height="14" RadiusX="1" RadiusY="1" Margin="0,0,3,0" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="Bar4" Width="5" Height="18" RadiusX="1" RadiusY="1" Margin="0,0,3,0" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="Bar5" Width="5" Height="22" RadiusX="1" RadiusY="1" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock x:Name="ClockText" FontFamily="{StaticResource NumberFont}" FontSize="13" Foreground="#C9C0CF"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
