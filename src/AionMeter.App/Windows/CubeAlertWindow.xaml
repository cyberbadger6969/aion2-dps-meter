<Window x:Class="AionMeter.App.Windows.CubeAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hidden cube" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        IsHitTestVisible="False" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}">
    <!-- "A hidden cube is near": a card of its own in the middle of the screen, like the game's own toasts; it never
         takes the mouse or the keyboard -->
    <Border Margin="14" CornerRadius="12" BorderThickness="1" Padding="14,10,18,10" MinWidth="330">
        <Border.Background>
            <SolidColorBrush Color="#14101A" Opacity="0.9" />
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#99E77C93" Offset="0" />
                <GradientStop Color="#33E77C93" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.65" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- A little cube in a glowing tile -->
            <Border Width="42" Height="42" CornerRadius="8" VerticalAlignment="Center" BorderThickness="1" BorderBrush="#80E77C93">
                <Border.Background>
                    <RadialGradientBrush>
                        <GradientStop Color="#55E77C93" Offset="0" />
                        <GradientStop Color="#1AE77C93" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                <Viewbox Margin="7">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12,2 L21,7 L12,12 L3,7 Z" Fill="#FFE9EE" />
                        <Path Data="M3,7 L12,12 L12,22 L3,17 Z" Fill="#E79AAA" />
                        <Path Data="M21,7 L12,12 L12,22 L21,17 Z" Fill="#B9566C" />
                        <Path Data="M12,8.2 L15,10 L12,11.8 L9,10 Z" Fill="#D2455F" />
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="11" FontWeight="Bold" Foreground="#F07A8F" />
                <TextBlock x:Name="MessageText" FontSize="15.5" FontWeight="Bold" Foreground="White" Margin="0,1,0,0">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
                <!-- From the chime: which side, nearer or farther -->
                <TextBlock x:Name="HintText" FontSize="12" Foreground="#E8B6C1" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Turns toward the chime: straight up = ahead, sideways = to that side, down = behind -->
                <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse x:Name="ArrowRing" Stroke="#66E77C93" StrokeThickness="1.5" Visibility="Collapsed" />
                    <Path x:Name="ArrowPath" Data="M17,4 L26,20 L19.5,17.5 L19.5,29 L14.5,29 L14.5,17.5 L8,20 Z" Fill="#FFE9EE"
                          RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ArrowTurn" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock x:Name="ClockText" FontFamily="{StaticResource NumberFont}" FontSize="13" Foreground="#C9C0CF"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
